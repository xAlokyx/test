# مثال على ملف متغيرات البيئة - Environment Variables Example
# انسخ هذا الملف إلى .env وقم بتعديل القيم

# JWT Secret Key - مفتاح سري لتوقيع JWT
# استخدم مفتاح قوي وعشوائي في بيئة الإنتاج
# يمكنك توليد مفتاح عشوائي باستخدام: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-secret-key-here

# Port - المنفذ الذي سيعمل عليه الخادم
PORT=3000

# Database Path - مسار قاعدة البيانات (اختياري)
# DB_PATH=./data/cms.db
